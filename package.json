{
  "name": "ai-desktop",
  "private": true,
  "version": "0.1.0",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:render\" \"npm:dev:electron\"",
    "dev:render": "vite --host 0.0.0.0",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "build": "vite build",
    "start": "electron ."
  },
  "dependencies": {
    "electron": "^31.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.8",
    "wait-on": "^8.0.0"
  }
}
